// Настройки Cloudflare Worker для TapReview.
// "name" должен совпадать с именем Worker в панели Cloudflare.
{
  "name": "tapreview",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Адреса /b/..., /c/..., /g/..., /go/..., /s/..., /api/... и /tg/... всегда обрабатывает код из src/, а не файлы
    "run_worker_first": ["/b/*", "/c/*", "/g/*", "/go/*", "/s/*", "/api/*", "/tg/*"]
  },
  // Это публичные значения (не секреты): publishable-ключ защищён RLS в Supabase.
  // Секретные ключи сюда НЕ писать — только через Settings → Variables and Secrets (тип Secret).
  "vars": {
    // Адрес, который попадает в ссылки, QR-коды и NFC-карты.
    // Постоянный домен (подключён 2026-10-11). Менять только при переезде на другой домен.
    "PUBLIC_BASE_URL": "https://tapreview.ru",
    "SUPABASE_URL": "https://snrnusvqqrhnljcmnncb.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6tOGONYM3yQkS8ZOeJDLHQ_f9u75f0d"
  },
  "keep_vars": true,
  // "17 3 * * *" — каждый день в 06:17 МСК: запрос к базе, чтобы Supabase не «уснул»
  // "0 6 * * 1"  — по понедельникам в 09:00 МСК: отчёт за неделю владельцам в Telegram
  //               (если меняете — поменяйте и WEEKLY_REPORT_CRON в src/index.js)
  "triggers": {
    "crons": ["17 3 * * *", "0 6 * * 1"]
  },
  "observability": {
    "enabled": true
  }
}
